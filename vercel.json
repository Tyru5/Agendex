{
  "buildCommand": "bun run build:cloud",
  "outputDirectory": "packages/ee/dist",
  "installCommand": "bun install",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.agendex.dev" }],
      "destination": "https://agendex.dev/$1",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
