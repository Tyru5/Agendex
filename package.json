{
  "name": "agendex",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd ./packages/app dev",
    "dev:client:oss": "bun run --cwd ./packages/app dev:client",
    "dev:client:ee": "bun run --cwd ./packages/ee dev:client",
    "build": "bun run --cwd ./packages/app build",
    "build:cloud": "bun run --cwd ./packages/ee build",
    "build:cli:release": "node ./packages/cli/scripts/build-release.mjs",
    "cli": "bun run --cwd ./packages/cli src/cli.ts",
    "cli:start": "bun run --cwd ./packages/cli src/cli.ts start",
    "cli:login": "bun run --cwd ./packages/cli src/cli.ts login",
    "cli:configure": "bun run --cwd ./packages/cli src/cli.ts configure",
    "cli:sync": "bun run --cwd ./packages/cli src/cli.ts sync",
    "cli:stop": "bun run --cwd ./packages/cli src/cli.ts stop",
    "cli:status": "bun run --cwd ./packages/cli src/cli.ts status",
    "changeset": "changeset",
    "check:cli:release": "bunx biome check .gitignore .changeset .github/workflows README.md docs/self-hosting.md package.json packages/cli packages/shared/package.json packages/shared/src/adapters/cursor.ts packages/app/src/client/components/landing/data.ts packages/web/src/client/components/landing/data.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "pack:cli:dry-run": "npm pack --dry-run ./packages/cli/.release",
    "smoke:cli:release": "node ./packages/cli/scripts/pack-and-smoke.mjs",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@biomejs/biome": "^2.4.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.9",
    "@types/node": "^24.3.1",
    "@types/mdast": "^4.0.4",
    "typescript": "^5"
  }
}
