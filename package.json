{
  "name": "agendex",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ./packages/app dev",
    "dev:client:oss": "bun run --cwd ./packages/app dev:client",
    "dev:client:ee": "bun run --cwd ./packages/ee dev:client",
    "build": "bun run --cwd ./packages/app build",
    "build:cloud": "cd packages/ee && bunx convex deploy --cmd 'bunx --bun vite build'",
    "build:cli:release": "node ./packages/cli/scripts/build-release.mjs",
    "cli": "bun run --cwd ./packages/cli src/cli.ts",
    "cli:start": "bun run --cwd ./packages/cli src/cli.ts start",
    "cli:login": "bun run --cwd ./packages/cli src/cli.ts login",
    "cli:logout": "bun run --cwd ./packages/cli src/cli.ts logout",
    "cli:open": "bun run --cwd ./packages/cli src/cli.ts open",
    "cli:view": "bun run --cwd ./packages/cli src/cli.ts view",
    "cli:configure": "bun run --cwd ./packages/cli src/cli.ts configure",
    "cli:sync": "bun run --cwd ./packages/cli src/cli.ts sync",
    "cli:stop": "bun run --cwd ./packages/cli src/cli.ts stop",
    "cli:status": "bun run --cwd ./packages/cli src/cli.ts status",
    "cli:hooks": "bun run --cwd ./packages/cli src/cli.ts hooks",
    "cli:review-plan": "bun run --cwd ./packages/cli src/cli.ts review-plan",
    "cli:cleanup": "bun run --cwd ./packages/cli src/cli.ts cleanup",
    "cli:add-dir": "bun run --cwd ./packages/cli src/cli.ts add-dir",
    "cli:remove-dir": "bun run --cwd ./packages/cli src/cli.ts remove-dir",
    "cli:list-dirs": "bun run --cwd ./packages/cli src/cli.ts list-dirs",
    "cli:upgrade": "bun run --cwd ./packages/cli src/cli.ts upgrade",
    "changeset": "changeset",
    "check:cli:release": "bun run fmt:check -- --ignore-path .gitignore .gitignore .changeset .github/workflows README.md docs/self-hosting.md package.json packages/cli packages/shared/package.json packages/shared/src/adapters/cursor.ts packages/app/src/client/components/landing/data.ts packages/web/src/client/components/landing/data.ts && bun run lint -- packages/cli packages/shared/src/adapters/cursor.ts packages/app/src/client/components/landing/data.ts packages/web/src/client/components/landing/data.ts",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun run fmt:check && bun run lint",
    "check:fix": "bun run fmt && bun run lint:fix",
    "pack:cli:dry-run": "npm pack --dry-run ./packages/cli/.release",
    "smoke:cli:release": "node ./packages/cli/scripts/pack-and-smoke.mjs",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.3.1",
    "convex": "^1.37.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "typescript": "^5"
  }
}
