{
  "name": "agendex",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @agendex/web dev",
    "dev:client": "bun run --filter @agendex/web dev:client",
    "build": "bun run --filter @agendex/web build",
    "cli": "bun run --filter @agendex/cli",
    "cli:start": "bun run packages/cli/src/cli.ts start",
    "cli:login": "bun run packages/cli/src/cli.ts login",
    "cli:sync": "bun run packages/cli/src/cli.ts sync",
    "cli:status": "bun run packages/cli/src/cli.ts status",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "prettier": "^3.8.1",
    "tidewave": "^0.6.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
