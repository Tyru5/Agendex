{
  "name": "agendex",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd ./packages/app dev",
    "dev:client": "bun run --cwd ./packages/app dev:client",
    "dev:client:oss": "bun run --cwd ./packages/app dev:client",
    "dev:client:ee": "bun run --cwd ./packages/ee dev:client",
    "build": "bun run --cwd ./packages/app build",
    "build:cloud": "bun run --cwd ./packages/ee build",
    "cli": "bun run --cwd ./packages/cli src/cli.ts",
    "cli:start": "bun run --cwd ./packages/cli src/cli.ts start",
    "cli:login": "bun run --cwd ./packages/cli src/cli.ts login",
    "cli:sync": "bun run --cwd ./packages/cli src/cli.ts sync",
    "cli:stop": "bun run --cwd ./packages/cli src/cli.ts stop",
    "cli:status": "bun run --cwd ./packages/cli src/cli.ts status",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@types/bun": "^1.3.9",
    "@types/mdast": "^4.0.4",
    "typescript": "^5"
  }
}
