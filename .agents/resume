#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

command -v bun >/dev/null 2>&1 || {
  echo "Bun is missing; rerun .agents/setup" >&2
  exit 1
}

command -v node >/dev/null 2>&1 || {
  echo "Node.js is missing; rerun .agents/setup" >&2
  exit 1
}

[[ -d node_modules ]] || {
  echo "Workspace dependencies are missing; rerun .agents/setup" >&2
  exit 1
}

if [[ -z "${AGENDEX_EE_PUBLIC_URL:-}" ]]; then
  echo "AGENDEX_EE_PUBLIC_URL is missing; configure it in Amp project environment variables" >&2
  exit 1
fi

echo "Orb dependencies and EE public URL are ready."
