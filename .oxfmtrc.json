{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "out/**",
    "**/dist/**",
    "coverage/**",
    "packages/cli/.release/**",
    "**/convex/_generated/**",
    "packages/ee/**/skills/convex*",
    "packages/ee/**/skills/convex*/**",
    "packages/web/src/client/dist/**",
    "**/*.css"
  ]
}
